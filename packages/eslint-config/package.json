{
  "name": "@nest/eslint-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ESLint flat configuration for the NEST monorepo",
  "type": "module",
  "exports": {
    ".": "./base.js",
    "./base": "./base.js",
