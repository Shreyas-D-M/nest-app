{
  "name": "@nest/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared React Native component foundation for the NEST client apps",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@nest/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.86"
  },
  "devDependencies": {
    "@nest/eslint-config": "workspace:*",
    "@nest/tsconfig": "workspace:*",
    "@types/node": "26.2.0",
    "@types/react": "19.2.2",
    "eslint": "10.9.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
