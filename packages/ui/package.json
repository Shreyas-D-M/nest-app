{
  "name": "@nest/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared React Native component foundation for the NEST client apps",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare": "pnpm build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@nest/tokens": "file:../tokens"
  },
  "peerDependencies": {
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@nest/eslint-config": "workspace:*",
    "@nest/tsconfig": "workspace:*",
    "@types/node": "26.2.0",
    "@types/react": "19.1.10",
    "eslint": "10.9.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
