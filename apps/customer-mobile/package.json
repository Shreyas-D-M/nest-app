{
  "name": "@nest/customer-mobile",
  "version": "0.0.0",
  "private": true,
  "description": "NEST customer mobile app (Expo)",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .expo .turbo"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@nest/i18n": "file:../../packages/i18n",
    "@nest/tokens": "file:../../packages/tokens",
    "@nest/types": "file:../../packages/types",
    "@nest/ui": "file:../../packages/ui",
    "@tanstack/react-query": "5.101.4",
    "expo": "~54.0.37",
    "expo-av": "~16.0.0",
    "expo-constants": "~18.0.7",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.0",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@nest/eslint-config": "file:../../packages/eslint-config",
    "@nest/tsconfig": "file:../../packages/tsconfig",
    "@types/react": "~19.1.10",
    "eslint": "10.9.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
