{
  "expo": {
    "name": "NEST",
    "slug": "nest-customer",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "nestcustomer",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "NEST needs microphone access so you can speak your service issue and we can transcribe it for matching."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
