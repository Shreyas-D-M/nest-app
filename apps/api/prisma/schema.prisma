// ---------------------------------------------------------------------------
// NEST — Prisma schema
//
// SCOPE: Phase 0 foundation + Phase 1 identity + Phase 2 catalog & supply
//        + Phase 3A booking core.
//
// The remainder of the schema described in docs/05_DATABASE.md (reviews,
// messaging, assets, …) is deliberately NOT defined here. Each table arrives
// with the phase that owns it, together with its migration and tests, so that
// no unused or speculative structure reaches the database.
//
// `service_questions` is documented but deferred: no endpoint in
// 06_API_SPEC.md reads or writes it, and it is consumed by the problem-assistant
// flow in a later phase.
//
// Conventions applied to every model:
//   * snake_case table and column names
//   * UUID public identifiers
//   * timestamptz columns; all timestamps stored in UTC
//   * created_at / updated_at on every table
//   * money as integer minor units (never float)
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 removed `url` from the datasource block. The connection string is
// supplied to the CLI through prisma.config.ts, and to the client at runtime
// through the pg driver adapter in prisma.service.ts.
datasource db {
  provider = "postgresql"
}

/// Durable idempotency records for booking and payment commands.
///
/// CLAUDE.md requires idempotent booking/payment commands. Storing the record in
/// PostgreSQL rather than Redis is deliberate: Redis is a cache and may evict,
/// and a lost idempotency record means a duplicate booking or a double charge.
///
/// `request_hash` lets the server detect a client reusing one key for two
/// different payloads, which is a bug on the client and must not be treated as a
/// successful replay.
model IdempotencyKey {
  id String @id @default(uuid()) @db.Uuid

  /// Logical command namespace, e.g. "bookings.create". Keys are unique per
  /// scope so that unrelated commands cannot collide.
  scope String @db.VarChar(100)

  /// Client-supplied key from the Idempotency-Key header.
  key String @db.VarChar(255)

  /// SHA-256 hex digest of the canonical request payload.
  requestHash String @map("request_hash") @db.Char(64)

  status IdempotencyStatus

  /// HTTP status of the stored response, present once completed.
  responseCode Int? @map("response_code")

  /// Stored response body, replayed verbatim on a repeated request.
  responseBody Json? @map("response_body")

  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  /// Records past this instant may be pruned. Prevents unbounded growth.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED

  @@map("idempotency_status")
}

// ---------------------------------------------------------------------------
// Phase 1 — Identity
// ---------------------------------------------------------------------------

/// Role values are not enumerated in 05_DATABASE.md; these were approved
/// explicitly. A professional is a user with a PROFESSIONAL role plus a
/// `professionals` record (users 1—0/1 professional), which arrives in Phase 2.
enum UserRole {
  CUSTOMER
  PROFESSIONAL
  ADMIN

  @@map("user_role")
}

/// DELETED supports soft deletion: operational records must be retained even
/// after a user leaves, so the row stays and the status changes.
enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

/// Platform user — customer, professional or admin.
///
/// `phone` is the login identity and is therefore unique and mandatory. Profile
/// fields are nullable because a user exists the moment their phone is verified,
/// before they have told us anything else about themselves.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// E.164, e.g. +919876543210. Stored normalised so one person resolves to one
  /// account regardless of how they typed it.
  phone String @unique @db.VarChar(16)

  email     String? @unique @db.VarChar(255)
  name      String? @db.VarChar(120)
  avatarUrl String? @map("avatar_url") @db.VarChar(2048)

  role   UserRole   @default(CUSTOMER)
  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  addresses             UserAddress[]
  sessions              Session[]
  professional          Professional?
  serviceRequests       ServiceRequest[]
  customerBookings      Booking[]                @relation("CustomerBookings")
  professionalBookings  Booking[]                @relation("ProfessionalBookings")
  extraWorkRequests     ExtraWorkRequest[]       @relation("ProfessionalExtraWork")
  supportTickets        SupportTicket[]          @relation("RequesterTickets")
  reviews               Review[]
  homes                 Home[]
  vehicles              Vehicle[]
  favorites             Favorite[]
  notifications         Notification[]
  conversationsAsCustomer     Conversation[] @relation("CustomerConversations")
  conversationsAsProfessional Conversation[] @relation("ProfessionalConversations")
  sentMessages                Message[]      @relation("SentMessages")

  @@index([status])
  @@map("users")
}

/// A saved address belonging to a user.
///
/// created_at/updated_at are added per 05_DATABASE.md's constraint that they be
/// applied consistently, and deleted_at supports soft deletion — bookings will
/// reference an address, so a hard delete would destroy booking history.
model UserAddress {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  label       String @db.VarChar(40)
  addressLine String @map("address_line") @db.VarChar(255)
  locality    String @db.VarChar(120)
  city        String @db.VarChar(120)
  state       String @db.VarChar(120)
  pincode     String @db.VarChar(6)

  /// Coordinates are measurements, not money: double precision is the
  /// conventional representation and carries far more precision than the six
  /// decimal places (~0.1 m) this needs. The "never floats" rule in
  /// 05_DATABASE.md applies to monetary values.
  latitude  Float? @db.DoublePrecision
  longitude Float? @db.DoublePrecision

  /// Free-text delivery guidance, e.g. "gate code 1234, second floor".
  instructions String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]
  bookings        Booking[]
  homes           Home[]

  @@index([userId, createdAt])
  @@map("user_addresses")
}

/// A refresh-token session.
///
/// Required by the documented POST /auth/refresh. Only a hash of the refresh
/// token is stored: a database dump must not hand an attacker usable tokens.
///
/// `familyId` groups a token and all of its rotations. Presenting an already
/// rotated token is the signature of a stolen token, and revoking the whole
/// family is the standard response.
model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// SHA-256 hex digest of the opaque refresh token.
  refreshTokenHash String @unique @map("refresh_token_hash") @db.Char(64)

  familyId String @map("family_id") @db.Uuid

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  /// Set when this token is rotated, so a replay can be distinguished from a
  /// token that was merely revoked.
  replacedById String? @map("replaced_by_id") @db.Uuid

  /// Truncated user agent, to help a user recognise their own sessions. No IP
  /// address is stored — PII minimisation.
  userAgent String? @map("user_agent") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A pending phone-verification challenge.
///
/// Required by the documented POST /auth/otp/request and /auth/otp/verify.
///
/// The attempt counter lives here rather than in Redis on purpose: a Redis
/// eviction would reset it and reopen brute force against a six-digit code.
/// Only an HMAC of the code is stored, never the code itself.
model OtpChallenge {
  id    String @id @default(uuid()) @db.Uuid
  phone String @db.VarChar(16)

  /// HMAC-SHA256 of the code, keyed with a server-side pepper. A plain digest of
  /// six digits would be trivially reversible from a database dump.
  codeHash String @map("code_hash") @db.Char(64)

  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  attemptCount Int       @default(0) @map("attempt_count")
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

// ---------------------------------------------------------------------------
// Phase 2 — Catalog & supply
// ---------------------------------------------------------------------------

/// How a price behaves, from 02_PRD.md: a fixed price must not silently change,
/// while a variable job requires inspection and a quotation.
enum PricingType {
  FIXED
  ESTIMATE

  @@map("pricing_type")
}

/// Professional verification lifecycle.
///
/// The three admin actions in 06_API_SPEC.md (approve / reject /
/// request-changes) imply these states. CLAUDE.md forbids claiming verification
/// unless it is complete, so only APPROVED may ever be surfaced as "verified".
enum VerificationStatus {
  /// Onboarded, no documents submitted yet.
  UNSUBMITTED
  /// Documents submitted, awaiting an admin decision.
  PENDING_REVIEW
  /// An admin asked for corrections.
  CHANGES_REQUESTED
  APPROVED
  REJECTED

  @@map("verification_status")
}

enum OnlineStatus {
  ONLINE
  OFFLINE

  @@map("online_status")
}

/// KYC document kinds.
///
/// Only the kind, the storage key and the review outcome are stored — never a raw
/// identity number. Holding an Aadhaar or PAN number would be sensitive personal
/// data that NEST has no need to keep (02_PRD.md: minimise sensitive data).
enum DocumentType {
  IDENTITY_PROOF
  ADDRESS_PROOF
  BUSINESS_REGISTRATION
  QUALIFICATION
  BANK_PROOF

  @@map("document_type")
}

/// Per-document review outcome.
///
/// Narrower than VerificationStatus on purpose: UNSUBMITTED and
/// CHANGES_REQUESTED are meaningless for a document that already exists, and a
/// shared enum would make those states representable.
enum DocumentVerificationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED

  @@map("document_verification_status")
}

/// A top-level service category, e.g. "Electrical".
///
/// 06_API_SPEC.md exposes no category CRUD endpoint, so the launch set is seeded
/// and served read-only, nested inside GET /services.
model Category {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @db.VarChar(80)
  slug      String  @unique @db.VarChar(80)
  icon      String? @db.VarChar(80)
  sortOrder Int     @map("sort_order")
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  services Service[]

  @@index([active, sortOrder])
  @@map("categories")
}

/// A bookable service within a category, e.g. "Ceiling fan installation".
model Service {
  id          String  @id @default(uuid()) @db.Uuid
  categoryId  String  @map("category_id") @db.Uuid
  name        String  @db.VarChar(120)
  slug        String  @unique @db.VarChar(120)
  description String? @db.VarChar(1000)

  pricingType PricingType @map("pricing_type")

  /// Indicative starting price in integer paise (₹1,250.50 → 125050).
  ///
  /// The field is named `…Minor` so no call site can mistake it for rupees; the
  /// column keeps the documented name. Null when the category has no meaningful
  /// starting price. Never a float — see 05_DATABASE.md.
  basePriceMinor Int? @map("base_price")

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category             Category              @relation(fields: [categoryId], references: [id])
  professionalServices ProfessionalService[]
  bookings             Booking[]

  @@index([categoryId, active])
  @@map("services")
}

/// A service professional. One per user at most (users 1—0/1 professional).
///
/// The user keeps their customer capabilities: a professional can still hold
/// addresses and, later, place bookings. `role` marks them as a professional for
/// RBAC, but professional endpoints authorise on this record, not on the role.
model Professional {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  businessName    String  @map("business_name") @db.VarChar(120)
  bio             String? @db.VarChar(1000)
  yearsExperience Int     @default(0) @map("years_experience")

  verificationStatus VerificationStatus @default(UNSUBMITTED) @map("verification_status")
  onlineStatus       OnlineStatus       @default(OFFLINE) @map("online_status")

  /// Average review score, once reviews exist. Decimal, never a float.
  ///
  /// Stays null through Phase 2 and is NOT exposed by the API: publishing a
  /// placeholder rating would be fabricating a metric, which
  /// 09_COMPETITIVE_POSITIONING.md forbids.
  rating Decimal? @db.Decimal(3, 2)

  completedJobs Int @default(0) @map("completed_jobs")

  // --- Review outcome -------------------------------------------------------
  // Not listed in 05_DATABASE.md, but required to implement the documented
  // approve / reject / request-changes endpoints: a professional who is asked for
  // corrections has to be told what to correct.

  /// Admin feedback shown to the professional. Never shown to customers.
  reviewNotes  String?   @map("review_notes") @db.VarChar(1000)
  reviewedById String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents    ProfessionalDocument[]
  services     ProfessionalService[]
  serviceAreas ProfessionalServiceArea[]
  availability ProfessionalAvailability[]
  reviews      Review[]
  favorites    Favorite[]

  @@index([verificationStatus, onlineStatus])
  @@map("professionals")
}

/// A KYC document submitted for verification.
model ProfessionalDocument {
  id             String @id @default(uuid()) @db.Uuid
  professionalId String @map("professional_id") @db.Uuid

  documentType DocumentType @map("document_type")

  /// Storage key within the configured document store — NOT a public URL.
  /// Access is always through a short-lived signed URL, per 06_API_SPEC.md.
  storageUrl String @map("storage_url") @db.VarChar(1024)

  verificationStatus DocumentVerificationStatus @default(PENDING_REVIEW) @map("verification_status")

  /// For documents that lapse, such as a licence. 02_PRD.md requires storing
  /// verification expiry where relevant.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)

  /// The admin who reviewed it. No relation, so the audit trail survives even if
  /// that admin's user row is later removed.
  reviewedById String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, documentType])
  @@map("professional_documents")
}

/// A service a professional offers, with their own price for it.
model ProfessionalService {
  id             String @id @default(uuid()) @db.Uuid
  professionalId String @map("professional_id") @db.Uuid
  serviceId      String @map("service_id") @db.Uuid

  /// The professional's starting price in integer paise.
  ///
  /// Proposed by the professional; the server remains the authority for what a
  /// customer is finally charged (CLAUDE.md).
  basePriceMinor Int @map("base_price")

  pricingType PricingType @map("pricing_type")
  active      Boolean     @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id])

  @@unique([professionalId, serviceId])
  @@index([serviceId, active])
  @@map("professional_services")
}

/// Where a professional will travel.
///
/// 05_DATABASE.md offers "locality/polygon/geohash"; V1 uses locality plus
/// pincode, matching 07_ARCHITECTURE.md's note that geospatial ranking comes
/// later. Geometry can be added alongside these columns without migrating them.
model ProfessionalServiceArea {
  id             String @id @default(uuid()) @db.Uuid
  professionalId String @map("professional_id") @db.Uuid

  locality String  @db.VarChar(120)
  pincode  String  @db.VarChar(6)
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, pincode, locality])
  @@index([pincode, active])
  @@map("professional_service_areas")
}

/// A recurring weekly working window.
///
/// **These are wall-clock times, not timestamps.** "09:00–18:00 on Monday" is a
/// rule that repeats, so it is stored as minutes from midnight in the service
/// area's local timezone — Asia/Kolkata for the Belagavi launch. Converting to
/// UTC would be wrong: the rule would shift if the operating timezone ever
/// changed. This is the one deliberate exception to CLAUDE.md's "timestamps in
/// UTC", which governs instants; a weekly opening hour is not an instant.
///
/// Minutes-from-midnight rather than a SQL `time` column because Prisma maps
/// `time` to a JavaScript Date with a placeholder date part, which invites
/// exactly the timezone coercion this model exists to avoid.
///
/// A `timezone` column will be required if NEST operates outside one timezone.
model ProfessionalAvailability {
  id             String @id @default(uuid()) @db.Uuid
  professionalId String @map("professional_id") @db.Uuid

  /// ISO-8601 day of week: 1 = Monday … 7 = Sunday.
  weekday Int

  /// Inclusive start, minutes from local midnight. 09:00 → 540.
  startMinute Int @map("start_time")

  /// Exclusive end, minutes from local midnight. 18:00 → 1080.
  endMinute Int @map("end_time")

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday])
  @@map("professional_availability")
}

/// An immutable record of a privileged action.
///
/// 06_API_SPEC.md requires admin actions to be audited. There is no relation to
/// `users`: an audit row must outlive the actor's account, so the id is stored
/// as a plain value rather than a foreign key that could cascade or block.
///
/// Rows are only ever inserted. Nothing in the codebase updates or deletes one.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// The acting user. Null for actions taken by the system itself.
  actorId String? @map("actor_id") @db.Uuid

  /// Dotted action name, e.g. "professional.approve".
  action String @db.VarChar(100)

  entityType String @map("entity_type") @db.VarChar(60)
  entityId   String @map("entity_id") @db.VarChar(64)

  /// Relevant state before and after. Only the fields the action touched, and
  /// never a secret or a document's contents.
  beforeJson Json? @map("before_json")
  afterJson  Json? @map("after_json")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 3A — Booking Core
// ---------------------------------------------------------------------------

/// Service request lifecycle from customer input to matched booking.
enum ServiceRequestStatus {
  DRAFT
  CLARIFYING
  READY
  MATCHED
  CANCELLED

  @@map("service_request_status")
}

/// Booking lifecycle through job execution and payment.
///
/// The flow follows 06_API_SPEC.md:
///   REQUESTED → ACCEPTED → ARRIVING → ARRIVED → IN_PROGRESS
///   → [optional EXTRA_APPROVAL_PENDING] → COMPLETED
///   → PAYMENT_PENDING → PAID → REVIEWED
///
/// Cancellation states exist for all three actor types who can cancel.
enum BookingStatus {
  REQUESTED
  ACCEPTED
  ARRIVING
  ARRIVED
  IN_PROGRESS
  EXTRA_APPROVAL_PENDING
  COMPLETED
  PAYMENT_PENDING
  PAID
  REVIEWED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_PROFESSIONAL
  CANCELLED_BY_ADMIN

  @@map("booking_status")
}

/// Who performed a booking state transition.
///
/// Required by booking_status_history to record actor accountability. SYSTEM
/// transitions occur for automated events such as payment confirmations.
enum ActorType {
  CUSTOMER
  PROFESSIONAL
  ADMIN
  SYSTEM

  @@map("actor_type")
}

/// Payment processing lifecycle.
enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED

  @@map("payment_status")
}

/// Support ticket categorization.
enum TicketType {
  BOOKING_ISSUE
  PAYMENT_ISSUE
  QUALITY_COMPLAINT
  SAFETY_CONCERN
  ACCOUNT_ISSUE
  OTHER

  @@map("ticket_type")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("ticket_priority")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  WAITING_INTERNAL
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

/// A customer's natural-language service request.
///
/// Created from text, voice, or photos. AI may classify and extract structured
/// details, but the raw input is preserved so a human can fall back to it if the
/// AI classification is wrong.
model ServiceRequest {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @map("customer_id") @db.Uuid

  /// Optional: customer may defer address selection until booking time.
  addressId String? @map("address_id") @db.Uuid

  /// The customer's own words.
  rawText String @map("raw_text") @db.Text

  /// Storage URL for a voice recording, if the request arrived by voice.
  voiceUrl String? @map("voice_url") @db.VarChar(1024)

  /// Attached photos or other media. JSON array of storage keys.
  media Json? @db.JsonB

  /// AI-suggested category slug, if classification ran.
  aiCategory String? @map("ai_category") @db.VarChar(120)

  /// AI classification confidence score [0, 1].
  aiConfidence Decimal? @map("ai_confidence") @db.Decimal(4, 3)

  status ServiceRequestStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  address  UserAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@index([customerId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("service_requests")
}

/// A scheduled job linking customer, professional, service, and pricing.
///
/// The booking is the core transactional record: every job done through NEST has
/// one. A booking without a service_request indicates a direct booking (customer
/// picked a service and professional themselves, no AI assistance).
model Booking {
  id             String @id @default(uuid()) @db.Uuid
  customerId     String @map("customer_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid
  serviceId      String @map("service_id") @db.Uuid
  addressId      String @map("address_id") @db.Uuid

  /// Links back to the originating request, if this booking came from one.
  requestId String? @map("request_id") @db.Uuid

  scheduledStart DateTime @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd   DateTime @map("scheduled_end") @db.Timestamptz(3)

  status BookingStatus @default(REQUESTED)

  /// Initial quoted price in integer paise. Set at booking creation and immutable.
  estimatedAmountMinor Int @map("estimated_amount")

  /// Actual charged amount including any extra work. Null until finalized.
  finalAmountMinor Int? @map("final_amount")

  /// NEST's platform fee in integer paise. Calculated when payment is initiated.
  platformFeeMinor Int? @map("platform_fee")

  /// Customer instructions to the professional.
  notes String? @db.VarChar(2000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer           User                    @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  professional       User                    @relation("ProfessionalBookings", fields: [professionalId], references: [id], onDelete: Restrict)
  service            Service                 @relation(fields: [serviceId], references: [id])
  address            UserAddress             @relation(fields: [addressId], references: [id], onDelete: Restrict)
  request            ServiceRequest?         @relation(fields: [requestId], references: [id], onDelete: SetNull)
  statusHistory      BookingStatusHistory[]
  items              BookingItem[]
  extraWorkReqs      ExtraWorkRequest[]
  payment            Payment?
  supportTickets     SupportTicket[]
  review             Review?
  invoice            Invoice?
  maintenanceRecords MaintenanceRecord[]
  conversation       Conversation?

  @@index([status, scheduledStart])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([professionalId, createdAt(sort: Desc)])
  @@index([professionalId, status, scheduledStart])
  @@map("bookings")
}

/// Immutable log of every booking status transition.
///
/// Records who moved the booking to each state and when. Required for dispute
/// resolution and accountability.
model BookingStatusHistory {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid

  status BookingStatus

  actorType ActorType  @map("actor_type")
  actorId   String?    @map("actor_id") @db.Uuid
  metadata  Json?      @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

/// A line item for extra work proposed by the professional.
///
/// Created when a professional proposes scope expansion. The `approved` flag is
/// set by the customer's response to the extra work request.
model BookingItem {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid

  description String @db.VarChar(500)

  /// Quantity may be fractional (e.g., 2.5 hours of labor).
  quantity Decimal @db.Decimal(10, 3)

  /// Unit price in integer paise.
  unitPriceMinor Int @map("unit_price")

  /// Set to true when the customer approves this item.
  approved Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, approved])
  @@map("booking_items")
}

/// A professional's proposal to expand the job scope, with evidence.
///
/// Transitions the booking to EXTRA_APPROVAL_PENDING. Customer must approve or
/// reject. If approved, the amount is added to the final total.
model ExtraWorkRequest {
  id             String @id @default(uuid()) @db.Uuid
  bookingId      String @map("booking_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid

  description String @db.Text

  /// Incremental cost in integer paise.
  amountMinor Int @map("amount")

  /// Storage URLs for photos documenting the need (e.g., unexpected damage).
  evidenceUrls String[] @map("evidence_urls")

  status String @default("PENDING") @db.VarChar(20)

  customerResponseAt DateTime? @map("customer_response_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking      Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  professional User    @relation("ProfessionalExtraWork", fields: [professionalId], references: [id], onDelete: Restrict)

  @@index([bookingId, status])
  @@index([professionalId, createdAt(sort: Desc)])
  @@map("extra_work_requests")
}

/// Payment record for one booking.
///
/// One payment per booking (unique constraint on booking_id). The provider fields
/// track integration state so payment status can be verified and reconciled.
model Payment {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @unique @map("booking_id") @db.Uuid

  /// Payment provider identifier, e.g. "razorpay".
  provider String @db.VarChar(50)

  /// Provider's payment ID. Null until payment is initiated with the provider.
  providerPaymentId String? @map("provider_payment_id") @db.VarChar(255)

  /// Total amount charged in integer paise.
  amountMinor Int @map("amount")

  currency String @default("INR") @db.Char(3)

  status PaymentStatus @default(PENDING)

  paidAt DateTime? @map("paid_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refunds PaymentRefund[]

  @@index([status, createdAt])
  @@index([providerPaymentId])
  @@map("payments")
}

/// A refund for a payment.
model PaymentRefund {
  id        String @id @default(uuid()) @db.Uuid
  paymentId String @map("payment_id") @db.Uuid
  amountMinor Int @map("amount_minor")
  status String @default("PENDING") @db.VarChar(20)
  reason String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, status])
  @@map("payment_refunds")
}

/// A support ticket raised by a customer or professional.
///
/// May optionally reference a booking. Type and priority guide routing and SLA.
model SupportTicket {
  id          String @id @default(uuid()) @db.Uuid
  requesterId String @map("requester_id") @db.Uuid

  /// Optional: not every ticket is booking-specific.
  bookingId String? @map("booking_id") @db.Uuid

  type     TicketType     @default(OTHER)
  priority TicketPriority @default(MEDIUM)
  status   TicketStatus   @default(OPEN)

  description String @db.Text

  /// Admin assigned to handle this ticket.
  assignedAdminId String? @map("assigned_admin_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)

  requester User             @relation("RequesterTickets", fields: [requesterId], references: [id], onDelete: Restrict)
  booking   Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  messages  TicketMessage[]

  @@index([status, priority, createdAt])
  @@index([requesterId, createdAt(sort: Desc)])
  @@index([assignedAdminId, status])
  @@map("support_tickets")
}

/// A message in a support ticket thread.
///
/// Authored by customer, professional, admin, or system. Internal messages
/// are visible only to staff.
model TicketMessage {
  id        String @id @default(uuid()) @db.Uuid
  ticketId  String @map("ticket_id") @db.Uuid
  authorId  String @map("author_id") @db.Uuid
  authorRole String @map("author_role") @db.VarChar(20)
  body      String @db.Text
  attachments String[] @default([]) @db.VarChar(1024)
  isInternal Boolean @default(false) @map("is_internal")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

/// A customer's review of a completed job.
///
/// Created after payment is verified. Rating is 1-5 stars. Comment and tags
/// provide qualitative feedback. Tags are predefined categories for analytics.
model Review {
  id             String @id @default(uuid()) @db.Uuid
  bookingId      String @unique @map("booking_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid

  rating Int
  comment String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customer     User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  professional Professional  @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  tags         ReviewTag[]

  @@index([professionalId, createdAt(sort: Desc)])
  @@map("reviews")
}

/// A tag attached to a review for categorization.
///
/// Tags are free-text but constrained by validation to a predefined set
/// (e.g., "punctual", "quality", "professional", "communicative", "value").
model ReviewTag {
  id       String @id @default(uuid()) @db.Uuid
  reviewId String @map("review_id") @db.Uuid
  tag      String @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([tag])
  @@map("review_tags")
}

/// An invoice for a completed booking.
///
/// Generated after payment is verified. Contains line items, tax, and total.
model Invoice {
  id             String @id @default(uuid()) @db.Uuid
  bookingId      String @unique @map("booking_id") @db.Uuid

  invoiceNumber  String   @unique @map("invoice_number") @db.VarChar(50)
  subtotal       Int      @map("subtotal_minor")
  fees           Int      @map("fees_minor")
  tax            Int      @map("tax_minor")
  total          Int      @map("total_minor")

  issuedAt       DateTime @map("issued_at") @db.Timestamptz(3)
  documentUrl    String?  @map("document_url") @db.VarChar(1024)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Phase 3 — Home Passport, My Garage, Favorites, Notifications
// ---------------------------------------------------------------------------

/// A customer's home/property.
model Home {
  id        String @id @default(uuid()) @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  name      String @db.VarChar(100)
  addressId String @map("address_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  address  UserAddress @relation(fields: [addressId], references: [id], onDelete: Restrict)
  assets   Asset[]

  @@index([customerId])
  @@map("homes")
}

/// An appliance, system, or other asset in a home.
enum AssetType {
  APPLIANCE
  HVAC
  PLUMBING
  ELECTRICAL
  STRUCTURAL
  OTHER

  @@map("asset_type")
}

model Asset {
  id        String @id @default(uuid()) @db.Uuid
  homeId    String @map("home_id") @db.Uuid
  assetType AssetType @map("asset_type")
  brand     String? @db.VarChar(100)
  model     String? @db.VarChar(100)
  serialNumber String? @map("serial_number") @db.VarChar(100)
  purchaseDate DateTime? @map("purchase_date") @db.Timestamptz(3)
  warrantyEnd DateTime? @map("warranty_end") @db.Timestamptz(3)
  notes     String? @db.VarChar(1000)
  imageUrl  String? @map("image_url") @db.VarChar(1024)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  home             Home               @relation(fields: [homeId], references: [id], onDelete: Cascade)
  maintenanceRecords MaintenanceRecord[]

  @@index([homeId])
  @@map("assets")
}

/// A maintenance/service record for an asset.
model MaintenanceRecord {
  id        String @id @default(uuid()) @db.Uuid
  assetId   String @map("asset_id") @db.Uuid
  bookingId String? @map("booking_id") @db.Uuid
  serviceDate DateTime @map("service_date") @db.Timestamptz(3)
  summary   String @db.Text
  nextDueDate DateTime? @map("next_due_date") @db.Timestamptz(3)
  cost      Int? @db.Integer // in minor units (paise)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([assetId, serviceDate(sort: Desc)])
  @@map("maintenance_records")
}

/// A customer's vehicle.
model Vehicle {
  id           String @id @default(uuid()) @db.Uuid
  customerId   String @map("customer_id") @db.Uuid
  make         String @db.VarChar(50)
  model        String @db.VarChar(50)
  variant      String? @db.VarChar(50)
  registrationMasked String @map("registration_masked") @db.VarChar(20)
  purchaseDate DateTime? @map("purchase_date") @db.Timestamptz(3)
  notes        String? @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("vehicles")
}

/// A customer's favorite professional.
model Favorite {
  id             String @id @default(uuid()) @db.Uuid
  customerId     String @map("customer_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  customer     User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([customerId, professionalId])
  @@index([customerId])
  @@map("favorites")
}

/// A notification sent to a user.
enum NotificationType {
  BOOKING_UPDATE
  PAYMENT_UPDATE
  REVIEW_RECEIVED
  EXTRA_WORK_REQUEST
  SUPPORT_UPDATE
  PROMOTIONAL
  SYSTEM

  @@map("notification_type")
}

model Notification {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  type      NotificationType
  title     String @db.VarChar(200)
  body      String @db.Text
  data      Json?  @db.JsonB
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

/// In-app chat conversation between customer and professional for a booking.
model Conversation {
  id             String @id @default(uuid()) @db.Uuid
  bookingId      String @unique @map("booking_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking      Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer     User       @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Restrict)
  professional User       @relation("ProfessionalConversations", fields: [professionalId], references: [id], onDelete: Restrict)
  messages     Message[]

  @@index([customerId, updatedAt(sort: Desc)])
  @@index([professionalId, updatedAt(sort: Desc)])
  @@map("conversations")
}

/// A message in a conversation.
enum MessageType {
  TEXT
  IMAGE
  VOICE
  SYSTEM

  @@map("message_type")
}

model Message {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  senderId       String @map("sender_id") @db.Uuid
  messageType    MessageType @default(TEXT) @map("message_type")
  body           String? @db.Text
  mediaUrl       String? @map("media_url") @db.VarChar(1024)
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User       @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}
