# ---------------------------------------------------------------------------
# NEST API — example environment
#
# Copy to `.env` and fill in local values:   cp .env.example .env
#
# `.env` is git-ignored and must never be committed. Every value below is a
# non-functional placeholder — no real credential belongs in this file.
# Staging and production values live in the deployment secret manager, not here.
# ---------------------------------------------------------------------------

# development | staging | production | test
NODE_ENV=development

PORT=3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# PostgreSQL connection string. Replace user, password, host and database.
DATABASE_URL=postgresql://nest:CHANGE_ME@localhost:5432/nest_dev?schema=public

# Redis is optional in development. When unset, Redis-backed features report as
# disabled rather than failing — Redis is a cache/queue, never a source of
# truth. Set it to exercise rate limiting and queues locally.
# REDIS_URL=redis://localhost:6379

# Comma-separated list of browser origins allowed to call the API.
# Used by the admin web app in development.
CORS_ALLOWED_ORIGINS=http://localhost:3001
