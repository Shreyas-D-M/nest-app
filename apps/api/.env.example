# ---------------------------------------------------------------------------
# NEST API — example environment
#
# Copy to `.env` and fill in local values:   cp .env.example .env
#
# `.env` is git-ignored and must never be committed. Every value below is a
# non-functional placeholder — no real credential belongs in this file.
# Staging and production values live in the deployment secret manager, not here.
# ---------------------------------------------------------------------------

# development | staging | production | test
NODE_ENV=development

PORT=3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Matches docker-compose.yml, which maps the container to host port 5433 so it
# does not collide with a Postgres you may already run on 5432.
DATABASE_URL=postgresql://nest:nest_local_dev@localhost:5433/nest_dev?schema=public

# Redis backs caching, rate limiting and queues — never the source of truth.
# Optional in development: when unset, rate limiting falls back to an in-process
# limiter and Redis-backed features report as disabled.
# REQUIRED in production; the API refuses to start without it.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Authentication secrets
#
# Generate real values with:  openssl rand -base64 48
# Minimum 32 characters. The API refuses to start if either is missing or short.
# These placeholders are non-functional — replace them locally.
# ---------------------------------------------------------------------------

# Signs access tokens. Rotating it invalidates every issued access token.
JWT_SECRET=REPLACE_ME_generate_with_openssl_rand_base64_48

# Keys the HMAC applied to OTP codes before storage.
OTP_HASH_PEPPER=REPLACE_ME_generate_with_openssl_rand_base64_48

# ---------------------------------------------------------------------------
# Token and OTP lifetimes (optional — defaults shown)
# ---------------------------------------------------------------------------

# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5

# SMS delivery provider.
# `log` writes the code to the application log and sends nothing — development
# only. Production rejects it at boot, because auth that silently fails to
# deliver codes is worse than auth that refuses to start.
SMS_PROVIDER=log

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3001
