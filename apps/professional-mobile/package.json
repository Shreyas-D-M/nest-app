{
  "name": "@nest/professional-mobile",
  "version": "0.0.0",
  "private": true,
  "description": "NEST professional mobile app (Expo)",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .expo .turbo"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.12",
    "@nest/i18n": "workspace:*",
    "@nest/tokens": "workspace:*",
    "@nest/types": "workspace:*",
    "@nest/ui": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@nest/eslint-config": "workspace:*",
    "@nest/tsconfig": "workspace:*",
    "@types/react": "19.2.2",
    "eslint": "10.9.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
