# ---------------------------------------------------------------------------
# NEST professional mobile — example environment
#
# Copy to `.env.local` (git-ignored) for local development.
#
# EXPO_PUBLIC_* values are inlined into the app bundle and are therefore PUBLIC.
# Never put a secret, API key or token behind an EXPO_PUBLIC_ prefix — anyone
# with the app can read it.
# ---------------------------------------------------------------------------

# Use your machine's LAN IP (not localhost) when testing on a physical device.
# Example: EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:3000
EXPO_PUBLIC_API_BASE_URL=http://<your-local-ip>:3000
