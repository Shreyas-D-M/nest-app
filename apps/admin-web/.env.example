# ---------------------------------------------------------------------------
# NEST admin web — example environment
#
# Copy to `.env.local` (git-ignored) for local development.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle and are therefore
# PUBLIC. Never put a secret, API key or token behind a NEXT_PUBLIC_ prefix.
# For browser testing on the same machine, localhost is fine; for a phone or
# another device on the same LAN, use the host machine's LAN IP instead.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
